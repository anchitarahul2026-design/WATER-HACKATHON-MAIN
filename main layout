
import tkinter as tk
from tkinter import messagebox

# Function to analyse water quality
def analyze_water():
    try:
        location = location_entry.get()
        ph = float(ph_entry.get())
        turbidity = float(turbidity_entry.get())
        tds = float(tds_entry.get())
        do = float(do_entry.get())

        # Validate input ranges
        if not location.strip():
            messagebox.showerror("Error", "Please enter a location.")
            return

        if not (0 <= ph <= 14):
            messagebox.showerror("Error", "pH must be between 0 and 14.")
            return

        if turbidity < 0 or tds < 0 or do < 0:
            messagebox.showerror(
                "Error", "Turbidity, TDS and DO cannot be negative."
            )
            return

        # Analyse individual parameters
        if 6.5 <= ph <= 8.5:
            ph_status = "Within reference range"
        else:
            ph_status = "Outside reference range"

        if turbidity <= 1:
            turbidity_status = "Acceptable"
        elif turbidity <= 5:
            turbidity_status = "Above acceptable limit"
        else:
            turbidity_status = "Exceeds permissible limit"

        if tds <= 500:
            tds_status = "Within acceptable limit"
        elif tds <= 2000:
            tds_status = "Above acceptable limit"
        else:
            tds_status = "Exceeds permissible limit"

        if do >= 5:
            do_status = "Higher dissolved oxygen"
        else:
            do_status = "Low dissolved oxygen"

        # Display results
        result = (
            f"Location: {location}\n\n"
            f"pH: {ph} - {ph_status}\n"
            f"Turbidity: {turbidity} NTU - {turbidity_status}\n"
            f"TDS: {tds} mg/L - {tds_status}\n"
            f"Dissolved Oxygen: {do} mg/L - {do_status}\n\n"
            "Note: This is a basic screening tool, "
            "not a drinking-water safety certification."
        )

        result_label.config(text=result)

    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter valid numerical values for all readings."
        )


# Create main window
root = tk.Tk()
root.title("Water Quality Monitoring System")
root.geometry("520x600")

# Heading
heading = tk.Label(
    root,
    text="WATER QUALITY MONITORING",
    font=("Arial", 16, "bold")
)
heading.pack(pady=15)

# Input frame
input_frame = tk.Frame(root)
input_frame.pack(pady=5)

# Location
tk.Label(input_frame, text="Location:").grid(
    row=0, column=0, sticky="w", padx=10, pady=8
)
location_entry = tk.Entry(input_frame, width=28)
location_entry.grid(row=0, column=1, pady=8)

# pH
tk.Label(input_frame, text="pH (0-14):").grid(
    row=1, column=0, sticky="w", padx=10, pady=8
)
ph_entry = tk.Entry(input_frame, width=28)
ph_entry.grid(row=1, column=1, pady=8)

# Turbidity
tk.Label(input_frame, text="Turbidity (NTU):").grid(
    row=2, column=0, sticky="w", padx=10, pady=8
)
turbidity_entry = tk.Entry(input_frame, width=28)
turbidity_entry.grid(row=2, column=1, pady=8)

# TDS
tk.Label(input_frame, text="TDS (mg/L):").grid(
    row=3, column=0, sticky="w", padx=10, pady=8
)
tds_entry = tk.Entry(input_frame, width=28)
tds_entry.grid(row=3, column=1, pady=8)

# Dissolved oxygen
tk.Label(input_frame, text="DO (mg/L):").grid(
    row=4, column=0, sticky="w", padx=10, pady=8
)
do_entry = tk.Entry(input_frame, width=28)
do_entry.grid(row=4, column=1, pady=8)

# Analyse button
analyze_button = tk.Button(
    root,
    text="Analyse Water Quality",
    command=analyze_water,
    font=("Arial", 11, "bold")
)
analyze_button.pack(pady=15)

# Results area
result_label = tk.Label(
    root,
    text="Enter the readings and click Analyse.",
    justify="left",
    anchor="w",
    wraplength=460,
    font=("Arial", 10)
)
result_label.pack(padx=20, pady=10, fill="x")

# Run GUI
root.mainloop()
