
import streamlit as st
import pandas as pd
from datetime import datetime
from pathlib import Path

# ---------------- CONFIGURATION ----------------

FILE = Path("water_readings.csv")

st.set_page_config(
    page_title="AquaTrace",
    page_icon="💧",
    layout="wide"
)

# ---------------- DATA STORAGE ----------------

columns = [
    "timestamp",
    "location",
    "pH",
    "turbidity_NTU",
    "pH_status",
    "turbidity_status"
]

if FILE.exists():
    history = pd.read_csv(FILE)
else:
    history = pd.DataFrame(columns=columns)

# ---------------- THRESHOLDS ----------------

st.sidebar.header("Screening thresholds")

ph_min = st.sidebar.number_input(
    "Minimum pH",
    min_value=0.0,
    max_value=14.0,
    value=6.5,
    step=0.1
)

ph_max = st.sidebar.number_input(
    "Maximum pH",
    min_value=0.0,
    max_value=14.0,
    value=8.5,
    step=0.1
)

turbidity_limit = st.sidebar.number_input(
    "Turbidity screening limit (NTU)",
    min_value=0.0,
    value=1.0,
    step=0.1
)

# ---------------- MAIN INTERFACE ----------------

st.title("AquaTrace")
st.subheader("Water Quality Monitoring Prototype")

st.info(
    "Enter actual sensor readings or sample values for a demo. "
    "Manual entries are not physical sensor measurements."
)

# ---------------- INPUT FORM ----------------

with st.form("measurement_form"):

    location = st.text_input(
        "Water source / location",
        placeholder="e.g. Hostel water tank A"
    )

    mode = st.radio(
        "Input mode",
        ["Manual readings", "Demo readings"],
        horizontal=True
    )

    if mode == "Manual readings":
        ph = st.number_input(
            "Measured pH",
            min_value=0.0,
            max_value=14.0,
            value=7.0,
            step=0.1
        )

        turbidity = st.number_input(
            "Measured turbidity (NTU)",
            min_value=0.0,
            value=0.5,
            step=0.1
        )
    else:
        st.caption(
            "These are illustrative values, not live sensor data."
        )
        ph = 5.8
        turbidity = 4.2
        st.write(f"Demo pH: {ph}")
        st.write(f"Demo turbidity: {turbidity} NTU")

    submitted = st.form_submit_button(
        "Analyze and Save Reading",
        type="primary"
    )

# ---------------- ANALYSIS ----------------

if submitted:

    if not location.strip():
        st.error("Please enter a location.")
    elif ph_min > ph_max:
        st.error("Minimum pH must not exceed maximum pH.")
    else:
        ph_status = (
            "Within screening range"
            if ph_min <= ph <= ph_max
            else "Outside screening range"
        )

        turbidity_status = (
            "Within screening limit"
            if turbidity <= turbidity_limit
            else "Above screening limit"
        )

        timestamp = datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        )

        new_record = pd.DataFrame([{
            "timestamp": timestamp,
            "location": location.strip(),
            "pH": ph,
            "turbidity_NTU": turbidity,
            "pH_status": ph_status,
            "turbidity_status": turbidity_status
        }])

        history = pd.concat(
            [history, new_record],
            ignore_index=True
        )

        history.to_csv(FILE, index=False)

        st.session_state["last_record"] = {
            "location": location.strip(),
            "pH": ph,
            "turbidity": turbidity,
            "pH_status": ph_status,
            "turbidity_status": turbidity_status,
            "timestamp": timestamp
        }

# ---------------- RESULTS ----------------

if "last_record" in st.session_state:
    result = st.session_state["last_record"]

    st.divider()
    st.header("Measurement Results")

    col1, col2 = st.columns(2)

    with col1:
        st.metric("pH", result["pH"])
        if result["pH_status"] == "Within screening range":
            st.success(result["pH_status"])
        else:
            st.warning(result["pH_status"])

    with col2:
        st.metric(
            "Turbidity",
            f'{result["turbidity"]} NTU'
        )
        if result["turbidity_status"] == "Within screening limit":
            st.success(result["turbidity_status"])
        else:
            st.warning(result["turbidity_status"])

    st.write("**Location:**", result["location"])
    st.write("**Recorded at:**", result["timestamp"])

    st.warning(
        "These checks screen only two water-quality parameters. "
        "They cannot establish whether water is safe to drink."
    )

# ---------------- HISTORY DASHBOARD ----------------

st.divider()
st.header("Measurement History")

if not history.empty:
    st.dataframe(
        history,
        use_container_width=True,
        hide_index=True
    )

    chart_data = history.copy()
    chart_data["pH"] = pd.to_numeric(
        chart_data["pH"], errors="coerce"
    )
    chart_data["turbidity_NTU"] = pd.to_numeric(
        chart_data["turbidity_NTU"], errors="coerce"
    )

    st.subheader("pH over time")
    st.line_chart(chart_data.set_index("timestamp")["pH"])

    st.subheader("Turbidity over time")
    st.line_chart(
        chart_data.set_index("timestamp")["turbidity_NTU"]
    )

    st.download_button(
        "Download readings as CSV",
        data=history.to_csv(index=False),
        file_name="water_readings.csv",
        mime="text/csv"
    )
else:
    st.write(
        "No readings recorded yet. Submit your first measurement above."
    )
